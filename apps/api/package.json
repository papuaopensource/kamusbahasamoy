{
  "name": "@kamusbahasamoy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --port 5000",
    "db:migrate": "uv run alembic upgrade head",
    "db:migration:create": "uv run alembic revision --autogenerate -m",
    "db:seed": "uv run python scripts/seed.py",
    "lint": "uv run ruff check .",
    "format": "uv run ruff format .",
    "test": "PYTHONPATH=. uv run pytest"
  }
}
