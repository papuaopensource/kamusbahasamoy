---
import "@fontsource-variable/onest";
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pathname = Astro.url.pathname;

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props as Props;
---

<html lang="id" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>

  <body class="flex min-h-[100dvh] flex-col">
    <a
      href="#konten-utama"
      class="focus:outline-ring border-border bg-primary text-primary-foreground fixed -top-20 left-3 z-50 rounded border px-4 py-2 text-sm font-medium focus:top-3 focus:outline-2 focus:outline-offset-2"
    >
      Lewati ke konten
    </a>
    <Header pathname={pathname} />
    <main id="konten-utama" class="relative grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
