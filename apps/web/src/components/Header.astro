---
const { pathname } = Astro.props;

const navItems = [
  { href: "/", label: "Beranda" },
  { href: "/kosa-kata/", label: "Kosa kata" },
  { href: "/lirik-lagu/", label: "Lirik lagu" },
  { href: "/kontribusi/", label: "Kontribusi" },
  { href: "/tentang/", label: "Tentang" },
];

const isActivePath = (href: string) =>
  href === "/" ? pathname === href : pathname.startsWith(href);

const navLinkClasses = (href: string) => [
  "focus-visible:outline-ring rounded px-3 py-2 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
  isActivePath(href)
    ? "bg-secondary text-foreground font-medium"
    : "text-muted-foreground hover:bg-secondary hover:text-foreground",
];
---

<header
  x-data="{ menuOpen: false }"
  @keydown.escape.window="menuOpen = false"
  @click.outside="menuOpen = false"
  class="border-border bg-background sticky top-0 z-40 border-b"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6"
  >
    <a
      href="/"
      class="focus-visible:outline-ring text-foreground text-xl font-bold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      kamusbahasamoy
    </a>

    <nav aria-label="Navigasi utama" class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActivePath(item.href) ? "page" : undefined}
            class:list={navLinkClasses(item.href)}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      aria-controls="navigasi-mobile"
      :aria-expanded="menuOpen"
      :aria-label="menuOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi'"
      @click="menuOpen = !menuOpen"
      class="border-border text-foreground focus-visible:outline-ring inline-flex size-10 items-center justify-center rounded border focus-visible:outline-2 focus-visible:outline-offset-2 md:hidden"
    >
      <svg
        x-show="!menuOpen"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="size-5"
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
      <svg
        x-show="menuOpen"
        x-cloak
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="size-5"
      >
        <path d="m6 6 12 12"></path>
        <path d="m18 6-12 12"></path>
      </svg>
    </button>
  </div>

  <nav
    id="navigasi-mobile"
    x-show="menuOpen"
    x-cloak
    aria-label="Navigasi utama mobile"
    class="border-border border-t px-4 py-3 md:hidden"
  >
    <div class="mx-auto grid max-w-7xl gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActivePath(item.href) ? "page" : undefined}
            class:list={[
              ...navLinkClasses(item.href),
              "flex min-h-11 items-center",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
