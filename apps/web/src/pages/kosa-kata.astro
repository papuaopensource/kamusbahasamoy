---
import MainLayout from "@/layouts/MainLayout.astro";

const alphabets = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---

<MainLayout
  title="Daftar Kosa Kata"
  description="Daftar kosa kata dalam bahasa Indonesia dan terjemahannya dalam bahasa Moy."
>
  <div class="site-container page-section" x-data="vocabulary">
    <div class="grid gap-8">
      <header
        class="flex flex-col items-start justify-between gap-6 border-b border-white/10 pb-8 md:flex-row md:items-end"
      >
        <div>
          <h1 class="text-2xl font-semibold text-neutral-100">Kosa kata</h1>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-400">
            Jelajahi kosa kata bahasa Indonesia dan terjemahannya dalam bahasa
            Moy.
          </p>
        </div>
        <label class="relative block w-full md:w-80">
          <span class="sr-only">Cari kata</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="absolute top-1/2 left-3 size-4 -translate-y-1/2 text-neutral-500"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            placeholder="Cari kata..."
            x-model.debounce.250ms="searchQuery"
            class="focus-visible:ring-ring h-10 w-full rounded border border-white/10 bg-neutral-800 pr-4 pl-10 text-sm text-neutral-100 outline-none placeholder:text-neutral-500 focus-visible:border-white/20 focus-visible:ring-1"
          />
        </label>
      </header>

      <section
        class="overflow-hidden rounded border border-white/10 bg-neutral-800/40"
      >
        <header class="border-b border-white/10 p-5">
          <div
            class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
          >
            <div>
              <h2 class="text-sm font-medium text-neutral-200">
                Daftar kosa kata
              </h2>
              <p class="mt-1 text-xs text-neutral-500">
                <span
                  x-text="loading ? 'Memuat...' : `${filteredWords.length} dari ${words.length} kata`"
                ></span>
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <label>
                <span class="sr-only">Filter kategori</span>
                <select
                  x-model="selectedCategory"
                  class="focus-visible:ring-ring h-10 rounded border border-white/10 bg-neutral-800 px-3 text-sm text-neutral-300 outline-none hover:border-white/20 focus-visible:ring-1"
                >
                  <option value="all">Semua kategori</option>
                  <template x-for="category in categories" :key="category">
                    <option
                      :value="category"
                      x-text="`${category} (${categoryCount(category)})`"
                    ></option>
                  </template>
                </select>
              </label>

              <div
                class="flex rounded border border-white/10 bg-neutral-800 p-1"
                aria-label="Mode tampilan"
              >
                <button
                  type="button"
                  aria-label="Tampilan grid"
                  @click="viewMode = 'grid'"
                  :aria-pressed="viewMode === 'grid'"
                  :class="viewMode === 'grid' ? 'bg-neutral-100 text-neutral-900' : 'text-neutral-500 hover:text-neutral-100'"
                  class="focus-visible:outline-ring inline-flex size-8 items-center justify-center rounded focus-visible:outline-2"
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="size-4"
                  >
                    <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                  </svg>
                </button>
                <button
                  type="button"
                  aria-label="Tampilan daftar"
                  @click="viewMode = 'list'"
                  :aria-pressed="viewMode === 'list'"
                  :class="viewMode === 'list' ? 'bg-neutral-100 text-neutral-900' : 'text-neutral-500 hover:text-neutral-100'"
                  class="focus-visible:outline-ring inline-flex size-8 items-center justify-center rounded focus-visible:outline-2"
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="size-4"
                  >
                    <path d="M8 6h13M8 12h13M8 18h13"></path>
                    <path d="M3 6h.01M3 12h.01M3 18h.01"></path>
                  </svg>
                </button>
              </div>

              <label>
                <span class="sr-only">Urutan kata</span>
                <select
                  x-model="sortOrder"
                  class="focus-visible:ring-ring h-10 rounded border border-white/10 bg-neutral-800 px-3 text-sm text-neutral-300 outline-none hover:border-white/20 focus-visible:ring-1"
                >
                  <option value="asc">Urutkan A-Z</option>
                  <option value="desc">Urutkan Z-A</option>
                </select>
              </label>
            </div>
          </div>
        </header>

        <div class="p-5">
          <p
            x-show="loading"
            class="py-12 text-center text-sm text-neutral-500"
          >
            Memuat data kamus...
          </p>
          <p
            x-show="error"
            x-cloak
            x-text="error"
            class="py-12 text-center text-sm text-red-300"
          >
          </p>

          <div
            x-show="!loading && !error && filteredWords.length > 0"
            x-cloak
            x-effect="filteredWords.length; searchQuery; selectedCategory; sortOrder; viewMode; $nextTick(() => resetAlphabet($refs.wordScroller))"
            class="grid grid-cols-[minmax(0,1fr)_2rem] gap-3"
          >
            <div
              x-ref="wordScroller"
              @scroll.passive="updateActiveLetter($event.currentTarget)"
              class="relative max-h-[620px] overflow-y-auto scroll-smooth pr-2"
            >
              <template x-for="group in groupedWords" :key="group.letter">
                <section
                  :data-letter="group.letter"
                  class="scroll-mt-2 pb-6 last:pb-0"
                >
                  <h3
                    x-text="group.letter"
                    class="sticky top-0 z-10 mb-3 border-b border-white/10 bg-neutral-800/95 py-2 text-sm font-semibold text-neutral-300 backdrop-blur"
                  >
                  </h3>
                  <div
                    :class="viewMode === 'grid' ? 'grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3' : 'space-y-2'"
                  >
                    <template x-for="word in group.words" :key="word.id">
                      <button
                        type="button"
                        @click="openDetail(word)"
                        :class="viewMode === 'grid' ? 'block' : 'flex items-center justify-between gap-4'"
                        class="focus-visible:outline-ring w-full rounded border border-white/10 bg-neutral-800/50 p-4 text-left transition-colors hover:border-white/20 hover:bg-neutral-700/50 focus-visible:outline-2 focus-visible:outline-offset-2"
                      >
                        <span class="min-w-0">
                          <span
                            class="block text-sm font-medium text-neutral-200"
                            x-text="word.text"></span>
                          <span
                            class="mt-1 block truncate text-xs text-neutral-500"
                            x-text="meanings(word)"></span>
                        </span>
                        <span
                          x-text="word.word_class?.name || '-'"
                          :class="viewMode === 'grid' ? 'mt-3 inline-flex' : 'inline-flex'"
                          class="shrink-0 rounded border border-white/10 bg-neutral-700/50 px-2 py-1 text-xs text-neutral-400"
                        ></span>
                      </button>
                    </template>
                  </div>
                </section>
              </template>
            </div>

            <nav
              aria-label="Navigasi abjad kosakata"
              class="self-start rounded border border-white/10 bg-neutral-800/70 py-1"
            >
              {
                alphabets.map((letter) => (
                  <button
                    type="button"
                    x-on:click={`scrollToLetter('${letter}', $refs.wordScroller)`}
                    x-bind:disabled={`!availableLetters.includes('${letter}')`}
                    x-bind:aria-current={`activeLetter === '${letter}' ? 'true' : undefined`}
                    x-bind:class={`activeLetter === '${letter}' ? 'bg-neutral-100 text-neutral-900' : availableLetters.includes('${letter}') ? 'text-neutral-500 hover:bg-neutral-700 hover:text-neutral-100' : 'cursor-default text-neutral-500/30'`}
                    class="focus-visible:outline-ring mx-auto flex size-5 items-center justify-center rounded text-xs font-medium focus-visible:outline-2"
                  >
                    {letter}
                  </button>
                ))
              }
            </nav>
          </div>

          <div
            x-show="!loading && !error && filteredWords.length === 0"
            x-cloak
            class="py-12 text-center"
          >
            <h2 class="text-sm font-medium text-neutral-300">
              Tidak ada kata yang ditemukan
            </h2>
            <p class="mt-1 text-xs text-neutral-500">
              Coba ubah filter atau kata kunci pencarian.
            </p>
          </div>
        </div>
      </section>
    </div>

    <dialog
      x-ref="wordDialog"
      x-effect="dialogOpen && !$refs.wordDialog.open ? $refs.wordDialog.showModal() : !dialogOpen && $refs.wordDialog.open ? $refs.wordDialog.close() : null"
      @cancel.prevent="closeDialog()"
      @click.self="closeDialog()"
      aria-labelledby="word-dialog-title"
      class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto rounded border border-white/10 bg-neutral-800 p-6 text-left text-neutral-100 backdrop:bg-black/70 sm:p-8"
    >
      <button
        type="button"
        aria-label="Tutup detail kata"
        @click="closeDialog()"
        class="focus-visible:outline-ring absolute top-4 right-4 inline-flex size-9 items-center justify-center rounded text-neutral-500 hover:bg-neutral-700 hover:text-neutral-100 focus-visible:outline-2"
      >
        <span aria-hidden="true" class="text-xl leading-none">×</span>
      </button>
      <header class="pr-10">
        <p
          class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
        >
          Detail kosakata
        </p>
        <h2
          id="word-dialog-title"
          class="mt-1 text-xl font-semibold text-neutral-100"
        >
          Bahasa Moy dan artinya
        </h2>
      </header>

      <div class="mt-6 text-sm leading-relaxed">
        <p x-show="loadingDetail" class="text-neutral-500">Memuat detail...</p>
        <p x-show="detailError" x-text="detailError" class="text-red-300"></p>
        <template x-if="wordDetail && !loadingDetail">
          <div class="space-y-6">
            <section
              aria-label="Pasangan kosakata dan arti"
              class="grid overflow-hidden rounded border border-white/10 sm:grid-cols-2"
            >
              <div class="p-5 sm:border-r sm:border-white/10">
                <p
                  class="text-xs font-medium tracking-wide text-neutral-500 uppercase"
                >
                  Bahasa Moy
                </p>
                <p
                  x-text="wordDetail.text"
                  class="mt-2 text-2xl font-semibold tracking-tight text-neutral-100"
                >
                </p>
                <button
                  type="button"
                  @click="speakText(wordDetail.text)"
                  :aria-label="`Dengarkan kata Bahasa Moy ${wordDetail.text}`"
                  class="mt-4 inline-flex items-center gap-2 text-xs font-medium text-neutral-500 hover:text-neutral-100"
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="size-4"
                  >
                    <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
                    <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                    <path d="M18 6a8.5 8.5 0 0 1 0 12"></path>
                  </svg>
                  Dengarkan kata
                </button>
              </div>

              <div
                class="border-t border-white/10 bg-neutral-700/50 p-5 sm:border-t-0"
              >
                <p
                  class="text-xs font-medium tracking-wide text-neutral-500 uppercase"
                >
                  Arti dalam Bahasa Indonesia
                </p>
                <p
                  x-text="meanings(wordDetail)"
                  class="mt-2 text-2xl font-semibold tracking-tight text-neutral-100"
                >
                </p>
              </div>
            </section>

            <dl
              class="flex flex-col gap-3 border-y border-white/10 py-4 sm:flex-row sm:gap-8"
            >
              <div class="flex items-baseline gap-2">
                <dt class="text-xs text-neutral-500">Kelas kata</dt>
                <dd
                  x-text="wordDetail.word_class?.name || 'Belum tersedia'"
                  class="text-sm font-medium text-neutral-300"
                >
                </dd>
              </div>
              <div class="flex items-baseline gap-2">
                <dt class="text-xs text-neutral-500">Pelafalan</dt>
                <dd
                  x-text="wordDetail.pronunciation || 'Belum tersedia'"
                  class="text-sm font-medium text-neutral-300"
                >
                </dd>
              </div>
            </dl>

            <section>
              <h3 class="mb-2 text-sm font-medium text-neutral-300">
                Penjelasan arti
              </h3>
              <p
                class="text-neutral-400"
                x-text="wordDetail.definition || 'Penjelasan arti belum tersedia.'"
              >
              </p>
            </section>

            <section>
              <h3 class="mb-3 text-sm font-medium text-neutral-300">
                Contoh penggunaan
              </h3>
              <div
                class="grid overflow-hidden rounded border border-white/10 sm:grid-cols-2"
              >
                <div class="p-4 sm:border-r sm:border-white/10">
                  <p class="text-xs font-medium text-neutral-500">
                    Kalimat Bahasa Moy
                  </p>
                  <p
                    x-text="wordDetail.example_original || 'Contoh kalimat belum tersedia.'"
                    class="mt-2 text-neutral-300"
                  >
                  </p>
                </div>
                <div
                  class="border-t border-white/10 bg-neutral-700/50 p-4 sm:border-t-0"
                >
                  <p class="text-xs font-medium text-neutral-500">
                    Arti dalam Bahasa Indonesia
                  </p>
                  <p
                    x-text="wordDetail.example_translation || 'Arti kalimat belum tersedia.'"
                    class="mt-2 text-neutral-400"
                  >
                  </p>
                </div>
              </div>
            </section>

            <section
              x-show="wordDetail.related_words?.length > 0"
              class="border-t border-white/10 pt-5"
            >
              <h3 class="mb-1 text-sm font-medium text-neutral-300">
                Kata Moy terkait
              </h3>
              <p class="mb-3 text-xs leading-relaxed text-neutral-500">
                Pilih kata untuk melihatnya di daftar kosakata.
              </p>
              <div class="flex flex-wrap gap-2">
                <template
                  x-for="related in wordDetail.related_words"
                  :key="related.id"
                >
                  <button
                    type="button"
                    @click="searchQuery = related.text; closeDialog()"
                    class="rounded border border-white/10 px-3 py-2 text-left hover:border-white/20"
                  >
                    <span
                      x-text="related.text"
                      class="block text-xs font-medium text-neutral-300"></span>
                    <span
                      x-text="meanings(related)"
                      class="mt-0.5 block text-xs text-neutral-500"></span>
                  </button>
                </template>
              </div>
            </section>
          </div>
        </template>
      </div>
    </dialog>
  </div>
</MainLayout>
