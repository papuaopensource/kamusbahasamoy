---
import MainLayout from "@/layouts/MainLayout.astro";

const alphabets = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---

<MainLayout
  title="Daftar Kosa Kata"
  description="Daftar kosa kata dalam bahasa Indonesia dan terjemahannya dalam bahasa Moy."
>
  <div class="site-container page-section" x-data="vocabulary">
    <div class="grid gap-8">
      <header
        class="flex flex-col items-start justify-between gap-6 border-b border-white/10 pb-8 md:flex-row md:items-end"
      >
        <div>
          <h1 class="text-2xl font-semibold text-neutral-100">Kosa kata</h1>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-400">
            Jelajahi kosa kata bahasa Indonesia dan terjemahannya dalam bahasa
            Moy.
          </p>
        </div>
        <label class="relative block w-full md:w-80">
          <span class="sr-only">Cari kata</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="absolute top-1/2 left-3 size-4 -translate-y-1/2 text-neutral-500"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            placeholder="Cari kata..."
            x-model.debounce.250ms="searchQuery"
            class="focus-visible:ring-ring h-10 w-full rounded border border-white/10 bg-neutral-800 pr-4 pl-10 text-sm text-neutral-100 outline-none placeholder:text-neutral-500 focus-visible:border-white/20 focus-visible:ring-1"
          />
        </label>
      </header>

      <section
        class="overflow-hidden rounded border border-white/10 bg-neutral-800/40"
      >
        <header class="border-b border-white/10 p-5">
          <div
            class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
          >
            <div>
              <h2 class="text-sm font-medium text-neutral-200">
                Daftar kosa kata
              </h2>
              <p class="mt-1 text-xs text-neutral-500">
                <span
                  x-text="loading ? 'Memuat...' : `${filteredWords.length} dari ${words.length} kata`"
                ></span>
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <label>
                <span class="sr-only">Filter kategori</span>
                <select
                  x-model="selectedCategory"
                  class="focus-visible:ring-ring h-10 rounded border border-white/10 bg-neutral-800 px-3 text-sm text-neutral-300 outline-none hover:border-white/20 focus-visible:ring-1"
                >
                  <option value="all">Semua kategori</option>
                  <template x-for="category in categories" :key="category">
                    <option
                      :value="category"
                      x-text="`${category} (${categoryCount(category)})`"
                    ></option>
                  </template>
                </select>
              </label>

              <div
                class="flex rounded border border-white/10 bg-neutral-800 p-1"
                aria-label="Mode tampilan"
              >
                <button
                  type="button"
                  aria-label="Tampilan grid"
                  @click="viewMode = 'grid'"
                  :aria-pressed="viewMode === 'grid'"
                  :class="viewMode === 'grid' ? 'bg-neutral-100 text-neutral-900' : 'text-neutral-500 hover:text-neutral-100'"
                  class="focus-visible:outline-ring inline-flex size-8 items-center justify-center rounded focus-visible:outline-2"
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="size-4"
                  >
                    <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                  </svg>
                </button>
                <button
                  type="button"
                  aria-label="Tampilan daftar"
                  @click="viewMode = 'list'"
                  :aria-pressed="viewMode === 'list'"
                  :class="viewMode === 'list' ? 'bg-neutral-100 text-neutral-900' : 'text-neutral-500 hover:text-neutral-100'"
                  class="focus-visible:outline-ring inline-flex size-8 items-center justify-center rounded focus-visible:outline-2"
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="size-4"
                  >
                    <path d="M8 6h13M8 12h13M8 18h13"></path>
                    <path d="M3 6h.01M3 12h.01M3 18h.01"></path>
                  </svg>
                </button>
              </div>

              <label>
                <span class="sr-only">Urutan kata</span>
                <select
                  x-model="sortOrder"
                  class="focus-visible:ring-ring h-10 rounded border border-white/10 bg-neutral-800 px-3 text-sm text-neutral-300 outline-none hover:border-white/20 focus-visible:ring-1"
                >
                  <option value="asc">Urutkan A-Z</option>
                  <option value="desc">Urutkan Z-A</option>
                </select>
              </label>
            </div>
          </div>
        </header>

        <div class="p-5">
          <div class="mb-5 flex flex-wrap gap-2" aria-label="Filter huruf">
            <button
              type="button"
              @click="setLetter('')"
              :aria-pressed="selectedLetter === ''"
              :class="selectedLetter === '' ? 'border-neutral-100 bg-neutral-100 text-neutral-900' : 'border-white/10 text-neutral-400 hover:border-white/20 hover:text-neutral-100'"
              class="focus-visible:outline-ring inline-flex h-8 items-center justify-center rounded border px-3 text-xs font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              Semua
            </button>
            {
              alphabets.map((letter) => (
                <button
                  type="button"
                  x-on:click={`setLetter('${letter}')`}
                  x-bind:aria-pressed={`selectedLetter === '${letter}'`}
                  x-bind:class={`selectedLetter === '${letter}' ? 'border-neutral-100 bg-neutral-100 text-neutral-900' : 'border-white/10 text-neutral-400 hover:border-white/20 hover:text-neutral-100'`}
                  class="focus-visible:outline-ring inline-flex size-8 items-center justify-center rounded border text-xs font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
                >
                  {letter}
                </button>
              ))
            }
          </div>

          <p
            x-show="loading"
            class="py-12 text-center text-sm text-neutral-500"
          >
            Memuat data kamus...
          </p>
          <p
            x-show="error"
            x-cloak
            x-text="error"
            class="py-12 text-center text-sm text-red-300"
          >
          </p>

          <div
            x-show="!loading && !error && filteredWords.length > 0"
            x-cloak
            :class="viewMode === 'grid' ? 'grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3' : 'space-y-2'"
            class="max-h-[500px] overflow-y-auto pr-2"
          >
            <template x-for="word in filteredWords" :key="word.id">
              <button
                type="button"
                @click="openDetail(word)"
                :class="viewMode === 'grid' ? 'block' : 'flex items-center justify-between gap-4'"
                class="focus-visible:outline-ring w-full rounded border border-white/10 bg-neutral-800/50 p-4 text-left transition-colors hover:border-white/20 hover:bg-neutral-700/50 focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                <span class="min-w-0">
                  <span
                    class="block text-sm font-medium text-neutral-200"
                    x-text="word.text"></span>
                  <span
                    class="mt-1 block truncate text-xs text-neutral-500"
                    x-text="meanings(word)"></span>
                </span>
                <span
                  x-text="word.word_class?.name || '-'"
                  :class="viewMode === 'grid' ? 'mt-3 inline-flex' : 'inline-flex'"
                  class="shrink-0 rounded border border-white/10 bg-neutral-700/50 px-2 py-1 text-xs text-neutral-400"
                ></span>
              </button>
            </template>
          </div>

          <div
            x-show="!loading && !error && filteredWords.length === 0"
            x-cloak
            class="py-12 text-center"
          >
            <h2 class="text-sm font-medium text-neutral-300">
              Tidak ada kata yang ditemukan
            </h2>
            <p class="mt-1 text-xs text-neutral-500">
              Coba ubah filter atau kata kunci pencarian.
            </p>
          </div>
        </div>
      </section>
    </div>

    <dialog
      x-ref="wordDialog"
      x-effect="dialogOpen && !$refs.wordDialog.open ? $refs.wordDialog.showModal() : !dialogOpen && $refs.wordDialog.open ? $refs.wordDialog.close() : null"
      @cancel.prevent="closeDialog()"
      @click.self="closeDialog()"
      class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded border border-white/10 bg-neutral-800 p-6 text-left text-neutral-100 backdrop:bg-black/70"
    >
      <button
        type="button"
        aria-label="Tutup detail kata"
        @click="closeDialog()"
        class="focus-visible:outline-ring absolute top-4 right-4 inline-flex size-9 items-center justify-center rounded text-neutral-500 hover:bg-neutral-700 hover:text-neutral-100 focus-visible:outline-2"
      >
        <span aria-hidden="true" class="text-xl leading-none">×</span>
      </button>
      <header class="pr-10">
        <div class="flex items-center gap-3">
          <h2
            class="text-xl font-semibold text-neutral-100"
            x-text="selectedWord?.text || 'Detail kata'"
          >
          </h2>
          <button
            x-show="selectedWord?.text"
            type="button"
            @click="speakText(selectedWord.text)"
            class="text-xs text-neutral-500 hover:text-neutral-100"
          >
            dengarkan
          </button>
        </div>
        <p
          class="mt-1 text-sm text-neutral-400"
          x-text="selectedWord ? meanings(selectedWord) : ''"
        >
        </p>
      </header>

      <div class="mt-6 space-y-5 text-sm leading-relaxed">
        <p x-show="loadingDetail" class="text-neutral-500">Memuat detail...</p>
        <p x-show="detailError" x-text="detailError" class="text-red-300"></p>
        <template x-if="wordDetail && !loadingDetail">
          <div class="space-y-5">
            <p
              class="rounded border border-white/10 bg-neutral-700/50 p-3 text-xs leading-relaxed text-neutral-500"
            >
              Detail ini mengikuti data yang tersimpan pada entri kamus.
              Informasi yang belum tersedia ditampilkan apa adanya.
            </p>
            <dl class="grid gap-3 sm:grid-cols-2">
              <div class="rounded border border-white/10 p-3">
                <dt class="text-xs text-neutral-500">Kelas kata</dt>
                <dd
                  x-text="wordDetail.word_class?.name || 'Belum tersedia'"
                  class="mt-1 text-sm font-medium text-neutral-300"
                >
                </dd>
              </div>
              <div class="rounded border border-white/10 p-3">
                <dt class="text-xs text-neutral-500">Pengucapan</dt>
                <dd
                  x-text="wordDetail.pronunciation || 'Belum tersedia'"
                  class="mt-1 text-sm font-medium text-neutral-300"
                >
                </dd>
              </div>
            </dl>
            <div>
              <h3 class="mb-2 text-sm font-medium text-neutral-300">
                Definisi
              </h3>
              <p
                class="text-neutral-400"
                x-text="wordDetail.definition || 'Tidak ada definisi'"
              >
              </p>
            </div>
            <div>
              <h3 class="mb-2 text-sm font-medium text-neutral-300">
                Contoh kalimat
              </h3>
              <p class="mb-1 text-xs text-neutral-500">Bahasa Moy</p>
              <p
                class="text-neutral-300"
                x-text="wordDetail.example_original || 'Tidak ada contoh kalimat'"
              >
              </p>
              <p
                x-show="wordDetail.example_translation"
                class="mt-3 mb-1 text-xs text-neutral-500"
              >
                Terjemahan Indonesia
              </p>
              <p
                x-show="wordDetail.example_translation"
                x-text="wordDetail.example_translation"
                class="text-neutral-400"
              >
              </p>
            </div>
            <div
              x-show="wordDetail.related_words?.length > 0"
              class="border-t border-white/10 pt-5"
            >
              <h3 class="mb-1 text-sm font-medium text-neutral-300">
                Kata terkait
              </h3>
              <p class="mb-3 text-xs leading-relaxed text-neutral-500">
                Pilih salah satu kata untuk menerapkannya sebagai pencarian
                baru.
              </p>
              <div class="flex flex-wrap gap-2">
                <template
                  x-for="related in wordDetail.related_words"
                  :key="related.id"
                >
                  <button
                    type="button"
                    @click="searchQuery = related.text; closeDialog()"
                    class="rounded border border-white/10 px-3 py-2 text-xs text-neutral-400 hover:border-white/20 hover:text-neutral-100"
                    x-text="related.text"></button>
                </template>
              </div>
            </div>
          </div>
        </template>
      </div>
    </dialog>
  </div>
</MainLayout>
