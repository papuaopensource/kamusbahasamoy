{
  "name": "kamusbahasamoy",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "preview": "turbo preview",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "turbo format",
    "test": "turbo test",
    "check:all": "pnpm lint && pnpm format && pnpm test",
    "db:migrate": "pnpm --filter @kamusbahasamoy/api db:migrate",
    "db:migration:create": "pnpm --filter @kamusbahasamoy/api db:migration:create",
    "db:seed": "pnpm --filter @kamusbahasamoy/api db:seed",
    "db:init": "pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.5.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
